{
  "name": "@docs-mirror/docs-mirror",
  "version": "1.0.0",
  "exports": "./src/engine.ts",
  "tasks": {
    "dev": "deno run --watch --allow-all src/cli.ts",
    "test": "deno test --allow-read --allow-env tests/",
    "lint": "deno lint",
    "fmt": "deno fmt",
    "check": "deno check src/**/*.ts",
    "compile": "deno compile --allow-all --env-file=.env.production --output=docs-mirror src/cli.ts",
    "compile:all": "deno task compile:linux && deno task compile:darwin-x64 && deno task compile:darwin-arm64 && deno task compile:windows",
    "compile:linux": "deno compile --allow-all --env-file=.env.production --target=x86_64-unknown-linux-gnu --output=dist/docs-mirror-linux-x64 src/cli.ts",
    "compile:darwin-x64": "deno compile --allow-all --env-file=.env.production --target=x86_64-apple-darwin --output=dist/docs-mirror-darwin-x64 src/cli.ts",
    "compile:darwin-arm64": "deno compile --allow-all --env-file=.env.production --target=aarch64-apple-darwin --output=dist/docs-mirror-darwin-arm64 src/cli.ts",
    "compile:windows": "deno compile --allow-all --env-file=.env.production --target=x86_64-pc-windows-msvc --output=dist/docs-mirror-windows-x64.exe src/cli.ts"
  },
  "imports": {
    "@std/yaml": "jsr:@std/yaml@^1",
    "@std/front-matter": "jsr:@std/front-matter@^1",
    "@std/path": "jsr:@std/path@^1",
    "@std/fs": "jsr:@std/fs@^1",
    "@std/dotenv": "jsr:@std/dotenv@^0.225",
    "@std/crypto": "jsr:@std/crypto@^1",
    "@std/encoding": "jsr:@std/encoding@^1",
    "@std/assert": "jsr:@std/assert@^1",
    "@std/fmt": "jsr:@std/fmt@^1"
  },
  "fmt": {
    "lineWidth": 100,
    "semiColons": false
  },
  "lint": {
    "rules": {
      "exclude": ["no-explicit-any"]
    }
  }
}
